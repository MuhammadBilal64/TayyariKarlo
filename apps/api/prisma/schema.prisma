generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder from Phase 1 (kept for migration history).
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            Profile?
  refreshTokens      RefreshToken[]
  assessmentAttempts AssessmentAttempt[]
  interviewSessions  InterviewSession[]
  signalSessions     SignalSession[]

  @@map("users")
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  rolePreference      String?
  experienceLevel     String?
  technologyInterests String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Question {
  id              String           @id @default(cuid())
  prompt          String
  topic           String
  difficulty      String
  options         String[]
  correctIndex    Int
  explanation     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessmentItems AssessmentItem[]

  @@index([topic, difficulty])
  @@map("questions")
}

model AssessmentAttempt {
  id            String           @id @default(cuid())
  userId        String
  topic         String
  difficulty    String
  questionCount Int
  status        String           @default("in_progress")
  score         Int?
  percent       Float?
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         AssessmentItem[]

  @@index([userId, status])
  @@map("assessment_attempts")
}

model AssessmentItem {
  id            String            @id @default(cuid())
  attemptId     String
  questionId    String
  orderIndex    Int
  selectedIndex Int?
  isCorrect     Boolean?
  attempt       AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("assessment_items")
}

model InterviewSession {
  id               String          @id @default(cuid())
  userId           String
  role             String
  techStack        String[]        @default([])
  experienceLevel  String
  questionCount    Int             @default(5)
  status           String          @default("in_progress")
  overallFeedback  String?
  overallScore     Int?
  provider         String          @default("none")
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns            InterviewTurn[]

  @@index([userId, status])
  @@map("interview_sessions")
}

model InterviewTurn {
  id           String           @id @default(cuid())
  sessionId    String
  orderIndex   Int
  kind         String           @default("main")
  questionText String
  answerText   String?
  feedback     String?
  score        Int?
  rubric       Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@map("interview_turns")
}

model SignalSession {
  id                   String              @id @default(cuid())
  userId               String
  scenarioId           String
  scenarioVersion      String
  variant              String
  role                 String
  experienceLevel      String
  status               String              @default("in_progress")
  phase                String              @default("briefing")
  simulatedTimeSeconds Int                 @default(0)
  hiddenState          Json
  startedAt            DateTime            @default(now())
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               SignalEvent[]
  hypotheses           SignalHypothesis[]
  decisions            SignalDecision[]
  evaluation           SignalEvaluation?
  replays              SignalReplay[]

  @@index([userId, status])
  @@map("signal_sessions")
}

model SignalEvent {
  id                   String        @id @default(cuid())
  sessionId            String
  sequence             Int
  eventType            String
  payload              Json
  simulatedTimeSeconds Int
  summary              String
  createdAt            DateTime      @default(now())
  session              SignalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId])
  @@map("signal_events")
}

model SignalHypothesis {
  id                     String        @id @default(cuid())
  sessionId              String
  claim                  String
  supportingEvidenceKeys String[]      @default([])
  missingEvidence        String?
  confidence             Int?
  sequence               Int
  supersedesId           String?
  createdAt              DateTime      @default(now())
  session                SignalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("signal_hypotheses")
}

model SignalDecision {
  id                     String        @id @default(cuid())
  sessionId              String
  decisionKey            String
  description            String
  reasoning              String
  expectedEffect         String
  verificationPlan       String
  supportingEvidenceKeys String[]      @default([])
  outcomeSummary         String?
  sequence               Int
  createdAt              DateTime      @default(now())
  session                SignalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replays                SignalReplay[]

  @@index([sessionId])
  @@map("signal_decisions")
}

model SignalEvaluation {
  id                   String        @id @default(cuid())
  sessionId            String        @unique
  rubricVersion        String
  dimensions           Json
  strengths            String[]      @default([])
  gaps                 String[]      @default([])
  recommendedPractice  String
  overallSummary       String
  scenarioExplanation  String
  createdAt            DateTime      @default(now())
  session              SignalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("signal_evaluations")
}

model SignalReplay {
  id                 String         @id @default(cuid())
  sessionId          String
  decisionId         String
  keepOrChange       String
  revisedDecisionKey String?
  reasoning          String
  comparisonNotes    String?
  createdAt          DateTime       @default(now())
  session            SignalSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  decision           SignalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("signal_replays")
}
