# Copy to apps/api/.env
DATABASE_URL="postgresql://tayyari:tayyari@localhost:5432/tayyari?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Auth (Phase 2)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Set true only if you intentionally allow POST /questions/seed in production.
# Prefer: pnpm --filter @tayyari/api prisma:seed
ALLOW_QUESTION_SEED="false"

# Cookie SameSite: use "none" when web and API are on different domains (Vercel + Render).
# Local same-origin/dev: "lax"
COOKIE_SAME_SITE="lax"

# Interviews
# Render / CI: mock (typed practice). Spoken judge: ollama on this machine.
LLM_PROVIDER="mock"
# LLM_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
# OLLAMA_MODEL="qwen2.5:7b-instruct"
# About 16 GB free: OLLAMA_MODEL="qwen2.5:14b"
# LLM_TIMEOUT_MS="120000"

# Local speech. Windows paths. whisper.cpp small, Piper en_US-lessac-medium.
# Missing binaries keep the Ollama judge and ask you to type.
# WHISPER_BIN="C:\\tools\\whisper\\whisper-cli.exe"
# WHISPER_MODEL="C:\\tools\\whisper\\ggml-small.bin"
# WHISPER_TIMEOUT_MS="60000"
# PIPER_BIN="C:\\tools\\piper\\piper.exe"
# PIPER_MODEL="C:\\tools\\piper\\en_US-lessac-medium.onnx"
# PIPER_TIMEOUT_MS="30000"
