# -----------------------------------------------------------------------------
# Local development environment
# 1) Start Postgres: docker compose up -d
# 2) Copy this file to apps/api/.env (or use apps/api/.env.example)
# 3) For web, copy apps/web/.env.example to apps/web/.env
# -----------------------------------------------------------------------------

# Database (required for API + Prisma)
DATABASE_URL="postgresql://tayyari:tayyari@localhost:5432/tayyari?schema=public"

# API server
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Auth secrets (required in Phase 2 — placeholders for now)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Production: keep false; use prisma db seed instead of POST /questions/seed
ALLOW_QUESTION_SEED="false"

# Web (Vite) — also set in apps/web/.env
VITE_API_URL="http://localhost:3000/api/v1"
